# Copy this file to `.env` and adjust values. `.env` is gitignored.

# Client API origin (no trailing slash). Leave empty to call the API on the same
# origin as the app (e.g. Vite dev server with `/api` proxy to your backend).
# Example: https://api.example.com
VITE_API_BASE_URL=

# Dev only: backend origin for the Vite `/api` proxy (see vite.config.ts).
# Defaults to http://localhost:3000 if unset.
# VITE_DEV_API_PROXY=http://localhost:3000
